# 站群服务器：绑定到该站点专用 IP 的 3000 端口（nginx 反代目标）
WEB_BIND_IP=127.0.0.1
WEB_PORT=3000

NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_API_URL=
# 登录页 Turnstile 站点密钥（与后端 TURNSTILE_SECRET_KEY 成对配置）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google 登录 Web Client ID（与后端 GOOGLE_OAUTH_CLIENT_ID 一致；空则隐藏 Google 按钮）
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 长内容仓库（默认 hiEndless/copyapes_content）
CONTENT_GITHUB_USERNAME=hiEndless
CONTENT_GITHUB_REPO=copyapes_content
CONTENT_GITHUB_BRANCH=main
# 可选：提高 GitHub API/raw 限额
# CONTENT_GITHUB_TOKEN=
# 本地优先读取内容仓根目录；设为空字符串可强制走远程
# CONTENT_LOCAL_ROOT=
# CONTENT_REVALIDATE_SECONDS=3600
